APP_ENV=production
HTTP_PORT=80
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PUBLIC_BASE_URL=https://papers.example.com

# Docker images. Replace these with equivalent trusted registry-mirror paths
# when Docker Hub is unavailable from the deployment region.
GO_IMAGE=golang:1.22-alpine
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=paper_kb
MYSQL_USERNAME=paper_kb_app
MYSQL_PASSWORD=replace_with_long_random_secret
MYSQL_ROOT_PASSWORD=replace_with_separate_root_secret
MYSQL_TLS_MODE=false

REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace_with_long_random_secret
REDIS_TLS=false

JWT_SECRET=replace_with_at_least_32_bytes_random_secret
SETUP_SECRET=replace_with_a_separate_one_time_deployment_secret
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=https://papers.example.com
TRUST_PROXY_CIDRS=172.20.0.0/16

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace_with_smtp_authorization_code
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Paper Knowledge Base
SMTP_TLS_MODE=starttls
EMAIL_CODE_TTL_SECONDS=600

UPLOAD_MAX_BYTES=209715200
UPLOAD_QUOTA_BYTES=107374182400
PARSE_TIMEOUT_SECONDS=120
SEARCH_MAX_PAGE_SIZE=100
RATE_LIMIT_ENABLED=true
LOGIN_LIMIT_MAX_FAILS=5
LOGIN_LIMIT_WINDOW_SECONDS=600
AUTO_MIGRATE=true
