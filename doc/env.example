# ===== 基础配置 =====
APP_ENV=production
# Web(nginx) 监听的宿主机端口（浏览器访问 http://服务器IP:HTTP_PORT，或由宝塔/Nginx 反代到它）
HTTP_PORT=80
# API 监听的宿主机端口（仅绑定 127.0.0.1，不对外暴露；与其他服务冲突时改这里）
API_PORT=8080
# 站点最终访问地址（用 IP 部署时填 http://服务器IP，有域名和 HTTPS 时填 https://域名）
PUBLIC_BASE_URL=http://127.0.0.1

# ===== Docker 镜像（国内服务器可替换为镜像加速地址）=====
GO_IMAGE=golang:1.22-alpine
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine

# ===== 构建加速（访问国外网络慢的服务器强烈建议保留这两行）=====
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY_URL=https://goproxy.cn,direct

# ===== MySQL（直接连接服务器上已有的 MySQL）=====
# 容器使用宿主机网络,填 127.0.0.1 即可直连本机 MySQL（host.docker.internal 也会被映射到 127.0.0.1）;
# MySQL 在另一台服务器时填那台服务器的 IP。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=paper_kb
MYSQL_USERNAME=paper_kb_app
MYSQL_PASSWORD=replace_with_long_random_secret
MYSQL_TLS_MODE=false

# ===== 安全密钥（必须修改，至少 32 字符随机串，且两者不能相同）=====
# 生成方法：openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_bytes_random_secret
SETUP_SECRET=replace_with_a_separate_one_time_deployment_secret

# ===== Cookie / CORS =====
# 使用 HTTPS 域名访问时设置为 true；用 http://IP 访问时必须为 false，否则无法登录
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 前后端同域部署（默认 nginx 反代）无需配置；跨域访问时填写前端地址，逗号分隔
CORS_ALLOWED_ORIGINS=

# ===== 上传与限流 =====
UPLOAD_MAX_BYTES=209715200
UPLOAD_QUOTA_BYTES=107374182400
SEARCH_MAX_PAGE_SIZE=100
LOGIN_LIMIT_MAX_FAILS=5
LOGIN_LIMIT_WINDOW_SECONDS=600
SESSION_TTL_SECONDS=43200
AUTO_MIGRATE=true
